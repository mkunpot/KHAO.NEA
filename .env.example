# Copy this file to .env.local and fill in your own values. Never commit .env.local.

# Supabase → Project Settings → API (Project URL)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# The *publishable* key (sb_publishable_...) or the legacy "anon" key. Both are safe to ship in
# browser code. NEVER put a secret key or the service_role key here.
# (VITE_SUPABASE_PUBLISHABLE_KEY, the name Supabase's dashboard suggests, works too.)
VITE_SUPABASE_ANON_KEY=

# Optional. The origin students should open (used for the join link + QR code). Set this when you
# run the teacher view on localhost, because a phone cannot reach "localhost", e.g.
# VITE_PUBLIC_BASE_URL=http://192.168.1.20:5173
VITE_PUBLIC_BASE_URL=
